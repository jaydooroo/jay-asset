# Local AWS/backend environment values.
# Copy this file to backend/.env.aws.local and fill in the real secret values.
# Do not commit backend/.env.aws.local.
#
# Note:
# - This file is for local PowerShell/script usage.
# - AWS Lambda has its own Environment variables screen.
# - Do NOT add AWS_DEFAULT_REGION manually in Lambda; Lambda manages AWS_REGION itself.

MARKET_PRICE_SOURCE=dynamodb
MARKET_INGEST_PROVIDER=tiingo
MARKET_PRICE_TABLE=jay-asset-daily-prices
PERFORMANCE_ENABLED=true
PERFORMANCE_TABLE=jay-asset-performance
CACHE_ENABLED=true
CACHE_TABLE=jay-asset-cache
AWS_DEFAULT_REGION=us-east-1

# Secret. Paste your real Tiingo API key into backend/.env.aws.local only.
TIINGO_API_KEY=replace_with_your_tiingo_api_key
